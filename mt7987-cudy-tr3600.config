# 使用defconfig/mt7987-cudy-tr3600.config 整理而来

# 整理时间 2026年 8月17日

# 设备: Cudy TR3600-v1 (MT7987B)

CONFIG_TARGET_mediatek=y

CONFIG_TARGET_mediatek_filogic=y

CONFIG_TARGET_MULTI_PROFILE=y

#######################################################################

#                            DEVICES                                  #

#######################################################################

CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cudy_tr3600-v1=y

